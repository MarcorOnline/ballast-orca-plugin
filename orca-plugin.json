{
  "manifestVersion": 2,
  "id": "ballast",
  "name": "Ballast",
  "version": "0.6.0",
  "description": "Shows what weighs on your coding agent's context in a folder (plugins, skills, MCP servers, claude.ai connectors, memory) and turns each item on or off for that folder only. Supports Claude Code and Codex.",
  "license": "Apache-2.0",
  "repository": "https://github.com/MarcorOnline/ballast-orca-plugin",
  "author": {
    "name": "Marco Rinaldi",
    "url": "https://github.com/MarcorOnline"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "ballast",
        "title": "Ballast",
        "icon": "gauge",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "ballast.toggle",
        "title": "Ballast: toggle the right sidebar",
        "action": "sidebar.right.toggle"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "ballast-total",
        "text": "Ballast",
        "icon": "gauge",
        "tooltip": "Estimated context (Ballast)",
        "command": "ballast.toggle"
      }
    ],
    "hooks": [
      {
        "event": "agent.launch.before"
      },
      {
        "event": "agent.tool.after"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
